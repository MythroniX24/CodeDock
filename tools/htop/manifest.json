{
  "id": "htop",
  "name": "Htop",
  "command": "htop",
  "description": "Process monitor",
  "homepage": "https://npmjs.com/package/htop",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "apt-get install -y htop || pkg install -y htop"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "apt-get remove -y htop || pkg uninstall -y htop"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "htop",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "htop",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}