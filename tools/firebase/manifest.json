{
  "id": "firebase",
  "name": "Firebase Tools",
  "command": "firebase",
  "description": "Firebase CLI",
  "homepage": "https://npmjs.com/package/firebase-tools",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "npm install -g firebase-tools"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "npm uninstall -g firebase-tools"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "firebase",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "firebase",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}