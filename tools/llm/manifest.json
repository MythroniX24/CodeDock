{
  "id": "llm",
  "name": "LLM",
  "command": "llm",
  "description": "Simon Willison LLM CLI",
  "homepage": "https://npmjs.com/package/llm",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "pip install llm"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "pip uninstall -y llm"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "llm",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "llm",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}