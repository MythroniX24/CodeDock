{
  "id": "fabric",
  "name": "Fabric",
  "command": "fabric",
  "description": "An open-source framework for augmenting humans using AI.",
  "homepage": "https://github.com/example/fabric",
  "category": "cli-tool",
  "popular": true,
  "installation": {
    "primary": {
      "method": "npm",
      "command": "npm install -g fabric-mock-package"
    }
  },
  "uninstall": {
    "method": "npm",
    "command": "npm uninstall -g fabric-mock-package"
  },
  "dependencies": [
    {
      "name": "node",
      "minVersion": "16.0.0",
      "required": true
    }
  ],
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "fabric",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "fabric",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}