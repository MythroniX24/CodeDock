{
  "id": "ripgrep",
  "name": "ripgrep",
  "command": "ripgrep",
  "description": "Fast search",
  "homepage": "https://npmjs.com/package/ripgrep",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "apt-get install -y ripgrep || pkg install -y ripgrep"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "apt-get remove -y ripgrep || pkg uninstall -y ripgrep"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "ripgrep",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "ripgrep",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}