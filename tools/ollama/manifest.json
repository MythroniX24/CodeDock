{
  "id": "ollama",
  "name": "Ollama",
  "command": "ollama",
  "description": "Local LLMs",
  "homepage": "https://npmjs.com/package/undefined",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "curl -fsSL https://ollama.com/install.sh | sh"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "echo \"Uninstall manually\""
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "ollama",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "ollama",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}