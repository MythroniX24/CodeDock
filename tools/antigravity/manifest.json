{
  "id": "antigravity",
  "name": "Antigravity CLI",
  "command": "agy",
  "description": "Antigravity CLI (Google)",
  "homepage": "https://antigravity.google",
  "category": "ai-coding-agent",
  "aliases": ["agy", "antigravity-cli"],
  "installation": {
    "primary": {
      "method": "shell",
      "command": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "notes": "Official shell installer"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "rm -rf ~/.antigravity && rm $(which agy)"
  },
  "update": {
    "method": "shell",
    "command": "curl -fsSL https://antigravity.google/cli/install.sh | bash"
  },
  "dependencies": [
    { "name": "curl", "required": true }
  ],
  "architectures": ["aarch64", "x86_64"],
  "compatibility": {
    "termux": true,
    "termuxNotes": "May require proot-distro for full compatibility",
    "minNodeVersion": ""
  },
  "verification": {
    "command": "agy",
    "args": ["--version"],
    "expectedOutput": "agy"
  },
  "launcher": {
    "command": "agy",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  },
  "auth": {
    "required": true,
    "method": "provider-direct",
    "notes": "Provider direct auth"
  }
}
