{
  "id": "fzf",
  "name": "fzf",
  "command": "fzf",
  "description": "Fuzzy finder",
  "homepage": "https://npmjs.com/package/fzf",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "apt-get install -y fzf || pkg install -y fzf"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "apt-get remove -y fzf || pkg uninstall -y fzf"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "fzf",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "fzf",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}