{
  "id": "tmux",
  "name": "Tmux",
  "command": "tmux",
  "description": "Terminal multiplexer",
  "homepage": "https://npmjs.com/package/tmux",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "apt-get install -y tmux || pkg install -y tmux"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "apt-get remove -y tmux || pkg uninstall -y tmux"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "tmux",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "tmux",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}