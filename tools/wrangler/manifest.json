{
  "id": "wrangler",
  "name": "Cloudflare Wrangler",
  "command": "wrangler",
  "description": "Workers CLI",
  "homepage": "https://npmjs.com/package/wrangler",
  "category": "cli-tool",
  "popular": false,
  "installation": {
    "primary": {
      "method": "shell",
      "command": "npm install -g wrangler"
    }
  },
  "uninstall": {
    "method": "shell",
    "command": "npm uninstall -g wrangler"
  },
  "architectures": [
    "aarch64",
    "x86_64",
    "armv7l",
    "i686"
  ],
  "compatibility": {
    "termux": true
  },
  "verification": {
    "command": "wrangler",
    "args": [
      "--version"
    ]
  },
  "launcher": {
    "command": "wrangler",
    "args": [],
    "interactive": true,
    "inheritStdio": true
  }
}